#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    mouse_holdtap: mouse_holdtap {
        compatible = "zmk,behavior-hold-tap";
        label = "MOUSE_HOLDTAP";
        bindings = <&mo>, <&tog>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <130>;
        flavor = "hold-preferred";
    };

    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <130>;
        flavor = "tap-preferred";
    };

    knob_scroll_vertical: knob_scroll_vertical {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
        label = "KNOB_SCROLL_VERTICAL";
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        en_ko {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <42 43 44>;
            timeout-ms = <350>;
            layers = <0>;
        };

        temporal_bt_layer {
            bindings = <&mo 2>;
            key-positions = <53 54>;
            timeout-ms = <350>;
            layers = <0>;
        };

        win_lock {
            bindings = <&kp LG(L)>;
            key-positions = <51 52 53>;
            timeout-ms = <350>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&hm ESC GRAVE   &kp N1        &kp N2        &kp N3              &kp N4   &kp N5     &kp N6  &kp N7     &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp TAB         &kp Q         &kp W         &kp E               &kp R    &kp T      &kp Y   &kp U      &kp I      &kp O           &kp P           &kp BSLH
&kp LCTRL       &kp A         &lt 4 S       &kp D               &lt 3 F  &kp G      &kp H   &kp J      &kp K      &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C               &kp V    &kp B      &kp N   &kp M      &kp COMMA  &kp DOT         &kp UP_ARROW    &kp FSLH
&kp CAPSLOCK    &kp LEFT_WIN  &kp LEFT_ALT  &mouse_holdtap 5 5  &mo 1    &kp SPACE  &mo 1   &kp SPACE  &kp ENTER  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&knob_scroll_vertical>, <&knob_scroll_vertical>;
        };

        F_layers {
            bindings = <
&trans     &kp F1   &kp F2   &kp F3   &trans  &trans  &trans    &trans     &trans  &kp MINUS  &kp EQUAL         &trans
&kp GRAVE  &kp F4   &kp F5   &kp F6   &none   &trans  &none     &kp PG_UP  &none   &trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans     &kp F7   &kp F8   &kp F9   &none   &trans  &kp DEL   &kp PG_DN  &trans  &trans     &trans            &trans
&trans     &kp F10  &kp F11  &kp F12  &trans  &none   &kp HOME  &kp END    &trans  &trans     &none             &trans
&trans     &trans   &trans   &trans   &trans  &trans  &trans    &trans     &trans  &trans     &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &kp W
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &out OUT_TOG  &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &mkp MB5   &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &trans  &trans
            >;

            sensor-bindings = <&knob_scroll_vertical>, <&knob_scroll_vertical>;

            // 编码器2：左右滚动
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &mkp MB5   &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &trans  &trans
            >;

            sensor-bindings = <&knob_scroll_vertical>, <&knob_scroll_vertical>;
        };
    };
};
